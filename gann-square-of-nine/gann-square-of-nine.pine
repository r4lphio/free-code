// Square of Nine Levels (basic, educational)
// A generic, textbook version of W. D. Gann's square-of-nine price levels, built from public sources:
//   level = (sqrt(anchor) + degrees / 180) ^ 2
// One full turn (360 degrees) adds 2 to the square root, 180 adds 1, 90 adds 0.5 and 45 adds 0.25.
// Sources: LuxAlgo, "Gann Square-of-9 Levels"; Strike Money, "Gann Square of 9 Calculator";
// Optuma Knowledge Base, "Square of 9 Gann Fan". See README.md for the links.
// This is an educational tool, not trading advice. In our test the levels did no better than random levels.
// As tested in r4lph's video "My AI tested Gann's square of nine". Free to use and change.

//@version=6
indicator("Square of Nine Levels (basic)", overlay = true, max_lines_count = 100, max_labels_count = 100)

anchorMode  = input.string("Latest swing", "Anchor", options = ["Latest swing", "Manual price"])
manualPrice = input.float(100.0, "Manual anchor price", minval = 0.0001)
swingLen    = input.int(10, "Swing length (bars on each side)", minval = 1)
degStep     = input.int(45, "Degrees between levels", options = [45, 90, 180, 360])
nLevels     = input.int(8, "Levels above and below", minval = 1, maxval = 40)
showLabels  = input.bool(true, "Show labels")
colUp       = input.color(color.orange, "Levels above the anchor")
colDn       = input.color(color.teal, "Levels below the anchor")

// A swing high (low) is the highest high (lowest low) of swingLen bars on each side.
// It is only known swingLen bars later, so the anchor never uses future bars.
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float swingPrice = na
var int swingBar = na
if not na(ph)
    swingPrice := ph
    swingBar := bar_index - swingLen
if not na(pl)
    swingPrice := pl
    swingBar := bar_index - swingLen

float anchor = anchorMode == "Manual price" ? manualPrice : swingPrice

// The square-of-nine level that is `deg` degrees away from price p.
sq9(float p, float deg) =>
    float r = math.sqrt(p) + deg / 180.0
    r > 0 ? r * r : na

var array<line> lvLines = array.new<line>()
var array<label> lvLabels = array.new<label>()

if barstate.islast and not na(anchor)
    for ln in lvLines
        line.delete(ln)
    array.clear(lvLines)
    for lb in lvLabels
        label.delete(lb)
    array.clear(lvLabels)
    int perTurn = int(360 / degStep)
    for i = -nLevels to nLevels
        float lvl = sq9(anchor, i * degStep)
        if not na(lvl)
            color c = i == 0 ? color.gray : i > 0 ? colUp : colDn
            string st = i % perTurn == 0 ? line.style_solid : line.style_dashed
            array.push(lvLines, line.new(bar_index - 1, lvl, bar_index, lvl, extend = extend.both, color = c, style = st))
            if showLabels
                string txt = str.tostring(i * degStep) + "°  " + str.tostring(lvl, format.mintick)
                array.push(lvLabels, label.new(bar_index + 3, lvl, txt, style = label.style_none, textcolor = c, size = size.small))
    if anchorMode == "Latest swing" and not na(swingBar)
        array.push(lvLabels, label.new(swingBar, anchor, "", style = label.style_circle, color = color.gray, size = size.tiny, tooltip = "anchor: the latest swing"))
